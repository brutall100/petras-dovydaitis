# Portas, kuriuo veiks vietinis serveris (http://localhost:3000)
PORT=3000

# Kelias iki SQLite duomenų bazės failo (sukuriamas automatiškai)
DB_FILE=data/orders.db

# Slaptas raktas užsakymų sąrašui peržiūrėti (GET /api/orders).
# Sugalvok ilgą atsitiktinę eilutę, pvz.: openssl rand -hex 32
ADMIN_TOKEN=pakeisk-i-ilga-atsitiktine-eilute
